{
  "name": "dsh-smart-compact",
  "version": "0.6.3",
  "description": "Context window auto-management for DeepSeek Harness: lossless zero-model rollover, budget reminders, notes.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "context-window",
    "context-management",
    "compaction",
    "rollover",
    "llm"
  ],
  "homepage": "https://www.npmjs.com/package/dsh-smart-compact",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoyyang/dsh-smart-compact.git"
  },
  "bugs": {
    "url": "https://github.com/hoyyang/dsh-smart-compact/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "BSD-3-Clause",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.5-rc <2",
    "@deepseek-ai/dsh-compaction": ">=0.1.5-rc <2",
    "@deepseek-ai/dsh-compaction-basic": ">=0.1.5-rc <2",
    "@deepseek-ai/dsh-home-paths": ">=0.1.5-rc <2",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc <2",
    "@deepseek-ai/dsh-session-query": ">=0.1.5-rc <2",
    "@deepseek-ai/dsh-token-meter": ">=0.1.5-rc <2",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc <2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction-basic": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-query": {
      "optional": true
    },
    "@deepseek-ai/dsh-token-meter": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0",
    "unrun": "^0.3.1",
    "vitest": "^3.2.0"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:client": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh.bundle": {
    "patch": "./cordis.patch.yml"
  },
  "publishConfig": {
    "access": "public"
  }
}
